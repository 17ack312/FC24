path='/root/FC24/'
cd /root/FC24



url='https://www.ea.com/games/ea-sports-fc/ratings?gender=0&orderBy=ovr%3Adesc'


#cat > "$path"'data'


if [ ! -f "$path"'data' ]
then
    touch "$path"'data'
else
    if [ `du "$path"'data' |tr -s '\t' ' ' | tr  -s ' ' |cut -d ' ' -f1|xargs` -gt 1 ]
    then
      mv "$path"'data' "$path"'data.old.'
      rm -f "$path"'data'
      touch "$path"'data'
    fi
fi


fetch(){
	arg="$1"
	

	curl -Ls "$url"'&page='"$1" | sed 's/<tr class="Table_row_/\n<tr class="Table_row_/gi' | sed 's/<\/tr>/<\/tr>\n/gi' | grep ^'<tr class="Table_row_' | grep -v '<th' 

	echo -e '\n' 


}


progress-bar() {
  local duration=${1}


    already_done() { for ((done=0; done<$elapsed; done++)); do printf "▇"; done }
    remaining() { for ((remain=$elapsed; remain<$duration; remain++)); do printf " "; done }
    percentage() { printf "| %s%%" $(( (($elapsed)*100)/($duration)*100/100 )); }
    clean_line() { printf "\r"; }

  for (( elapsed=1; elapsed<=$duration; elapsed++ )); do
      already_done; remaining; percentage
      sleep 1
      clean_line
  done
  clean_line
}



data=`curl -Ls "$url" `



echo "$data" > "$path"'data'



max=`echo "$data" | sed 's/<\/a>/<\/a>\n/gi' | grep 'class="HeadlessButton_container' |  grep 'class="generated_utility' | grep '</span></a>'$ |tail -1 | sed 's/<\/span><\/a>$//gi' |rev |cut -d '>' -f1 |rev |xargs`

total=`echo "$data" |sed 's/</\n</gi' | grep 'FilterData_results_' -iE |rev |cut -d ' ' -f2 |rev|xargs`


sp="/-\|"

for i in `seq "$max"`
do
  if [ $i -gt 1 ]
  then
	   fetch "$i" >> "$path"'data'

	   #echo -e "Total = $max\tCurrent=$i\tRemaining=$(($max-$i))"
	   #progress-bar "$max"
  fi
  echo -e "Total Players: $total \t Total Pages: $max \t Remaining: $(($max-i))" 
  clear
  printf "\b${sp:i%${#sp}:1}"
done